{
  "outline_panel": {
    "expand_outlines_with_depth": 120,
  },
  "ssh_connections": [
    {
      "host": "100.103.165.17",
      "username": "darrylbrooks",
      "args": [],
      "projects": [
        {
          "paths": ["/Users/darrylbrooks"],
        },
      ],
    },
  ],
  "session": {
    "trust_all_worktrees": true,
  },
  "unnecessary_code_fade": 0.4000000059604645,
  "buffer_font_weight": 400.0,
  "buffer_font_size": 13.0,
  "buffer_font_family": "Geist Mono",
  "ui_font_family": "Geist",
  "ui_font_size": 14.0,
  "when_closing_with_no_tabs": "keep_window_open",
  "restore_on_startup": "none",
  "context_servers": {
    "planetscale-context-server": {
      "enabled": false,
      "settings": {},
    },
    "prisma-mcp": {
      "enabled": false,
      "settings": {},
    },
    "posthog": {
      "enabled": true,
      "url": "https://mcp.posthog.com/mcp",
      "headers": {
        "Authorization": "Bearer undefined"
      }
    },
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte (Blur)",
    "dark": "Quill",
  },
  "base_keymap": "Cursor",
  "vim_mode": true,
  "soft_wrap": "preferred_line_length",
  "preferred_line_length": 100,
  "hover_popover_delay": 160,
  "autoscroll_on_clicks": true,
  "confirm_quit": true,

  "seed_search_query_from_cursor": "selection",
  "use_smartcase_search": true,
  "search": {
    "case_sensitive": false,
    "include_ignored": false,
    "whole_word": false,
  },
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
    "use_system_clipboard": "on_yank",
    "highlight_on_yank_duration": 250,
  },
  "minimap": {
    "show": "auto",
    "thumb_border": "left_only",
  },
  "project_panel": {
    "dock": "right",
    "auto_fold_dirs": false,
  },
  "terminal": {
    "dock": "bottom",
    "cursor_shape": "hollow",
    "line_height": "standard",
  },
  "bottom_dock_layout": "left_aligned",
  "toolbar": {
    "quick_actions": false,
    "selections_menu": false,
  },
  "tabs": {
    "git_status": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
  },
  "agent": {
    "tool_permissions": {
      "default": "allow",
    },
    "play_sound_when_agent_done": true,
    "inline_assistant_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5-thinking-latest",
    },
    "default_model": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-5-thinking-latest",
    },
    "default_profile": "write",
    "dock": "left",
  },
  "languages": {
    "TSX": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "npx",
          "arguments": ["prettier", "--config", ".prettierrc", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "npx",
          "arguments": ["prettier", "--config", ".prettierrc", "--stdin-filepath", "{buffer_path}"],
        },
      },
      "inlay_hints": {
        "enabled": true,
        "edit_debounce_ms": 300,
        "show_parameter_hints": false,
        "show_type_hints": false,
      },
    },
    "Python": {
      "format_on_save": "on",
      "language_servers": ["pyright", "python-refactoring", "ruff"],
      "indent_guides": {
        "coloring": "indent_aware",
      },
      "formatter": [
        { "code_action": "source.fixAll.ruff" },
        { "code_action": "source.organizeImports.ruff" },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
      "inlay_hints": {
        "enabled": true,
        "edit_debounce_ms": 300,
        "show_parameter_hints": false,
        "show_type_hints": false,
      },
    },
    "Go": {
      "format_on_save": "on",
      "enable_language_server": true,
      "preferred_line_length": 100,
      "inlay_hints": {
        "show_type_hints": false,
        "enabled": true,
        "show_other_hints": false,
      },
    },
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          // "tsserver": {
          //   "maxTsServerMemory": 16184
          // }
        },
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 150,
          "lint": {
            "extendSelect": ["I"],
          },
        },
      },
    },
    "gopls": {
      "initialization_options": {
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": false,
          "constantValues": true,
          "functionTypeParameters": false,
          "parameterNames": true,
          "rangeVariableTypes": true,
        },
      },
    },
  },
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null,
    },
  },
  "file_types": {
    "Dockerfile": ["Dockerfile*"],
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager",
  },
}
